rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile matching UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Buildings collection readable by authenticated users
    match /buildings/{buildingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    }

    // Default allow read for authenticated users for demo/prototyping
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
